{
	"version": 11,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 3,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "og-msvc",
			"displayName": "Fallout 4 OG - MSVC x64",
			"generator": "Visual Studio 18 2026",
			"binaryDir": "${sourceDir}/build/og-msvc",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"COMMONLIB_RUNTIME_VR": "OFF",
				"COMMONLIB_RUNTIME_OG": "ON",
				"COMMONLIB_RUNTIME_NG": "OFF",
				"COMMONLIB_RUNTIME_AE": "OFF",
				"CMAKE_SYSTEM_NAME": "Windows",
				"CMAKE_SYSTEM_VERSION": "10.0.19045.0",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
				"VCPKG_HOST_TRIPLET": "x64-windows-static-md",
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
			}
		},
		{
			"name": "dual-msvc",
			"displayName": "Fallout 4 OG + AE - MSVC x64",
			"inherits": "og-msvc",
			"binaryDir": "${sourceDir}/build/dual-msvc",
			"cacheVariables": {
				"COMMONLIB_RUNTIME_VR": "OFF",
				"COMMONLIB_RUNTIME_OG": "ON",
				"COMMONLIB_RUNTIME_NG": "OFF",
				"COMMONLIB_RUNTIME_AE": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "og-msvc-debug",
			"configurePreset": "og-msvc",
			"configuration": "Debug"
		},
		{
			"name": "og-msvc-release",
			"configurePreset": "og-msvc",
			"configuration": "RelWithDebInfo"
		},
		{
			"name": "dual-msvc-debug",
			"configurePreset": "dual-msvc",
			"configuration": "Debug"
		},
		{
			"name": "dual-msvc-release",
			"configurePreset": "dual-msvc",
			"configuration": "RelWithDebInfo"
		}
	],
	"testPresets": [
		{
			"name": "og-msvc-release",
			"configurePreset": "og-msvc",
			"configuration": "RelWithDebInfo",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "dual-msvc-release",
			"configurePreset": "dual-msvc",
			"configuration": "RelWithDebInfo",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}
