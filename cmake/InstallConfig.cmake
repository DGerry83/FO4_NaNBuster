if(NOT DEFINED NANBUSTER_CONFIG_SOURCE OR NOT DEFINED NANBUSTER_CONFIG_DESTINATION)
	message(FATAL_ERROR "InstallConfig.cmake requires NANBUSTER_CONFIG_SOURCE and NANBUSTER_CONFIG_DESTINATION")
endif()

if(NOT EXISTS "${NANBUSTER_CONFIG_DESTINATION}")
	get_filename_component(configDirectory "${NANBUSTER_CONFIG_DESTINATION}" DIRECTORY)
	file(INSTALL DESTINATION "${configDirectory}" TYPE FILE FILES "${NANBUSTER_CONFIG_SOURCE}")
endif()
