# NaNBuster corrected-DXBC embed script (Chunk C6).
# Converts a validated patched.dxbc into a data-only C++ include exposing
# NaNBuster::Generated::CorrectedShaderDxbc (std::array<std::uint8_t, N>) and
# NaNBuster::Generated::CorrectedShaderDxbcSize. The output contains data
# declarations only: no includes, functions, or runtime state; the consumer
# translation unit supplies <array>, <cstddef>, and <cstdint>.
#
# Required -D variables:
#   NANBUSTER_INPUT   absolute path to the validated patched.dxbc
#   NANBUSTER_OUTPUT  absolute path to the generated patched.inc

if(NOT DEFINED NANBUSTER_INPUT OR NOT DEFINED NANBUSTER_OUTPUT)
	message(FATAL_ERROR "EmbedShader.cmake requires -DNANBUSTER_INPUT and -DNANBUSTER_OUTPUT")
endif()

if(NOT EXISTS "${NANBUSTER_INPUT}")
	message(FATAL_ERROR "EmbedShader.cmake: input '${NANBUSTER_INPUT}' does not exist")
endif()

file(SIZE "${NANBUSTER_INPUT}" NANBUSTER_INPUT_SIZE)
if(NANBUSTER_INPUT_SIZE LESS_EQUAL 0)
	message(FATAL_ERROR "EmbedShader.cmake: input '${NANBUSTER_INPUT}' is empty")
endif()

file(READ "${NANBUSTER_INPUT}" NANBUSTER_HEX HEX)

# "aabbcc..." -> "0xaa,0xbb,0xcc," -> strip trailing comma -> wrap 16 per line.
string(REGEX REPLACE "(..)" "0x\\1," NANBUSTER_BYTES "${NANBUSTER_HEX}")
string(REGEX REPLACE ",$" "" NANBUSTER_BYTES "${NANBUSTER_BYTES}")
string(REGEX REPLACE "((0x[0-9a-fA-F]{2},){16})" "\\1\n\t\t" NANBUSTER_BYTES "${NANBUSTER_BYTES}")

set(NANBUSTER_INC_CONTENT
"// Generated by cmake/EmbedShader.cmake from patched.dxbc; data declarations only.
namespace NaNBuster::Generated
{
	inline constexpr std::array<std::uint8_t, ${NANBUSTER_INPUT_SIZE}> CorrectedShaderDxbc{
		${NANBUSTER_BYTES}
	};
	inline constexpr std::size_t CorrectedShaderDxbcSize = CorrectedShaderDxbc.size();
}
")

file(WRITE "${NANBUSTER_OUTPUT}" "${NANBUSTER_INC_CONTENT}")
